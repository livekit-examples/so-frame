# One .env for the whole deploy stack. Copy to `.env`; both the robot and the
# policy load it (common.load_env walks up to this dir).

# --- Shared: LiveKit wire (every process) -------------------------------
LIVEKIT_URL=wss://your-livekit-instance.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_ROOM=so-frame
# PORTAL_FPS=10               # CONTROL/publish rate; MUST stay 10 to match the policy's
#                             # training control_freq. Do not raise it -- a faster send
#                             # loop integrates deltas too often and drives the arm above
#                             # the trained (real-matched) speed. (Camera capture rate is
#                             # separate; see SO101_CAM_FPS below.)

# --- robot: leslider (integrated 7-DOF: arm + gripper + rail) -----------
# One Feetech bus drives all 7 motors (SO101SliderPosFollower); the rail is a real
# STS3215, reported/commanded as slider.pos in 0..100 (== our wire dof_slider.pos).
LESLIDER_PORT=/dev/ttyACM0
LESLIDER_ID=leslider
# LESLIDER_SLIDER_GOAL_SPEED=0   # 0 = rail moves to goal at full speed; >0 caps ticks/s
# Cameras. Linux: /dev/videoN. macOS: integer index (0, 1, ...).
SO101_CAM_ARM=/dev/video0
SO101_CAM_OVERHEAD=/dev/video2
SO101_CAM_WIDTH=640
SO101_CAM_HEIGHT=480
# SO101_CAM_FPS=30           # camera HARDWARE capture rate. USB cams typically only do
#                            # 30 (asking for 10 fails lerobot's fps validation). The
#                            # 10 Hz control loop samples the latest frame off this.
# Rest pose the `reset_to_zero_position` RPC parks at (REAL wire units: arm deg,
# gripper + rail 0..100). Defaults in robot/run.py; override per joint. NEEDS-CALIBRATION.
# RESET_POSE_SLIDER=49.0
# RESET_POSE_SHOULDER_PAN=0.0
# RESET_POSE_SHOULDER_LIFT=-30.0
# RESET_POSE_ELBOW_FLEX=45.0
# RESET_POSE_WRIST_FLEX=35.0
# RESET_POSE_WRIST_ROLL=0.0
# RESET_POSE_GRIPPER=10.0

# --- policy: inference (uv run policy) ----------------------------------
# Trained checkpoint. Required. It records its own encoder, resolution, camera count and
# proprio layout, so there is nothing else to configure here.
POLICY_CHECKPOINT=/path/to/ckpt_best.pt
# POLICY_DEVICE=cuda          # cuda | mps | cpu. Default is cuda-if-available else cpu, NOT
                              # autodetect: set mps explicitly on a Mac or it runs on the CPU.
# OPERATOR_NAME=policy
# OPERATOR_TITLE=RL policy
