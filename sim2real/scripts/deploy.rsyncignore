# Patterns for scripts/deploy_to_robot.sh (same syntax as .gitignore).
# Everything NOT listed ships to the robot -- including `.env`, so the robot
# inherits the shared LIVEKIT_* config without re-entry.

# Version control / Python / caches.
.git/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Weights + recordings: the checkpoint lives on the training box, not here. Set
# SQUINT_CHECKPOINT on the robot (or scp the .pt over) -- see the deploy output.
# The small camera-mapping JSONs are NOT excluded; the policy needs them.
*.pt
runs/
runs_backup/
*.mp4

# Editor / OS noise.
.vscode/
.idea/
.DS_Store

# Per-machine overrides; each machine keeps its own.
.env.local
