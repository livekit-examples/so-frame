#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "so101_on_frame"
    doc = """Generated from Composed Stage of root layer /tmp/tmp7xo4emga/so101_on_frame.usdc


Generated from Composed Stage of root layer /tmp/mjcf_import_so101_on_frame_dz9udo35/usdex_so101_on_frame/so101_on_frame.usdc


