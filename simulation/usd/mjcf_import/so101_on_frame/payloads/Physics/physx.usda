"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "so101_on_frame"
{
    over "Geometry"
    {
        over "tn__20mm_gantry_plate_"
        {
            over "shoulder_link"
            {
                over "upper_arm_link"
                {
                    over "lower_arm_link"
                    {
                        over "wrist_link"
                        {
                            over "gripper_link"
                            {
                                over "moving_jaw_so101_v1_link"
                                {
                                    over "gripper" (
                                        prepend apiSchemas = ["PhysxJointAPI"]
                                    )
                                    {
                                        float physxJoint:armature = 0.0284034
                                        float physxJoint:jointFriction = 0.052393
                                    }
                                }

                                over "wrist_roll" (
                                    prepend apiSchemas = ["PhysxJointAPI"]
                                )
                                {
                                    float physxJoint:armature = 0.0284034
                                    float physxJoint:jointFriction = 0.052393
                                }
                            }

                            over "wrist_flex" (
                                prepend apiSchemas = ["PhysxJointAPI"]
                            )
                            {
                                float physxJoint:armature = 0.0284034
                                float physxJoint:jointFriction = 0.052393
                            }
                        }

                        over "elbow_flex" (
                            prepend apiSchemas = ["PhysxJointAPI"]
                        )
                        {
                            float physxJoint:armature = 0.0284034
                            float physxJoint:jointFriction = 0.052393
                        }
                    }

                    over "shoulder_lift" (
                        prepend apiSchemas = ["PhysxJointAPI"]
                    )
                    {
                        float physxJoint:armature = 0.0284034
                        float physxJoint:jointFriction = 0.052393
                    }
                }

                over "shoulder_pan" (
                    prepend apiSchemas = ["PhysxJointAPI"]
                )
                {
                    float physxJoint:armature = 0.0284034
                    float physxJoint:jointFriction = 0.052393
                }
            }

            over "dof_slider" (
                prepend apiSchemas = ["PhysxJointAPI"]
            )
            {
                float physxJoint:armature = 0.1
            }
        }
    }
}

