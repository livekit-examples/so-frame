#usda 1.0
(
    customLayerData = {
        string creator = "MuJoCo USD Converter v0.2.0"
    }
    defaultPrim = "so101_on_frame"
    doc = """Generated from Composed Stage of root layer /tmp/tmpguq9v7ua/so101_on_frame.usdc


