<?xml version="1.0" encoding="utf-8"?>
<robot name="so101_on_frame">
  <!-- Combined model: SO-101 arm on the 1-DOF linear frame, with wrist camera. -->
  <!-- Actuated joints: dof_slider (prismatic) + shoulder_pan/shoulder_lift/elbow_flex/wrist_flex/wrist_roll/gripper. -->
  <!-- frame_wrist_camera = camera optical frame (+Z = view direction, +X right, +Y down). -->
  <!-- Mesh paths are relative to this file. -->
  <material name="3d_printed">
    <color rgba="1 1 1 1" />
  </material>
  <material name="sts3215">
    <color rgba="0.1 0.1 0.1 1.0" />
  </material>
  <!-- ===================== FRAME (so_frame) ===================== -->
  <link name="100cm">
    <inertial>
      <mass value="0.000170827" />
      <origin xyz="0 -1.38778e-17 0.5" rpy="0 -0 0" />
