      </geometry>
      <material name="extrusion_gray">
        <color rgba="0.4 0.4 0.4 1" />
      </material>
    </visual>
    <!-- Collision box for the linear rail the gantry rides on. The frame's extrusions
         ship visual-only from the CAD export; the arm otherwise phases straight through
         this rail in sim, learning motions that would hit the real aluminum. Box matches
         the 2020 profile's mesh bounds in this link frame (long axis = world travel axis).
         100cm_4 is the slider joint's parent, so the box is fixed and the arm moves past
         it. Other extrusions stay visual-only (out of the arm's reach). -->
    <collision>
      <origin xyz="-0.008 0.01 -0.5" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.02 1.0" />
      </geometry>
    </collision>
  </link>
